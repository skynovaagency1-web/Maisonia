{
  "name": "maisonia",
  "version": "0.2.0",
  "private": true,
  "description": "Maisonia : mise en relation entre particuliers et artisans locaux (plomberie, électricité, peinture, petits travaux).",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build-views.js",
    "start": "npm run build && node --disable-warning=ExperimentalWarning src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply maisonia --local",
    "db:migrate": "wrangler d1 migrations apply maisonia --remote",
    "deploy": "wrangler deploy",
    "pretest": "npm run build",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "cookie-session": "^2.1.1",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  }
}
