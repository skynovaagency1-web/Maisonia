<%- include('partials/head') %>
<div class="narrow">
  <div class="page-head"><h1 class="display">Mon compte</h1></div>
  <div class="panel">
    <table>
      <tr><th>Nom</th><td><%= user.name %></td></tr>
      <tr><th>E-mail</th><td><%= user.email %></td></tr>
      <tr><th>Téléphone</th><td><%= user.phone || '—' %></td></tr>
      <tr><th>Type de compte</th><td><%= { client: 'Particulier', artisan: 'Artisan', admin: 'Administrateur' }[user.role] %></td></tr>
    </table>
    <p class="small muted">Pour modifier ces informations ou exercer vos droits (accès, rectification, portabilité, opposition), écrivez-nous à l'adresse indiquée dans la <a href="/confidentialite">politique de confidentialité</a>.</p>
  </div>
  <% if (user.role !== 'admin') { %>
  <div class="panel" style="margin-top:20px;border-color:#efc9c3">
    <h3>Supprimer mon compte</h3>
    <p class="muted">Votre compte, vos demandes, devis, photos et avis seront définitivement effacés.</p>
    <form class="stack" method="post" action="/compte/supprimer" onsubmit="return confirm('Supprimer définitivement votre compte ?')">
      <label>Confirmez avec votre mot de passe<input type="password" name="password" required autocomplete="current-password"></label>
      <button class="btn" style="background:var(--err);color:#fff" type="submit">Supprimer définitivement</button>
    </form>
  </div>
  <% } %>
</div>
<%- include('partials/foot') %>
