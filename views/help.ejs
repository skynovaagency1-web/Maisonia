<%- include('partials/head') %>
<% const faq = {
  'Particuliers': [
    ['Combien coûte Servizone ?', 'Rien. Publier une demande, recevoir des devis et échanger avec les artisans est gratuit pour les particuliers.'],
    ['Qui voit ma demande ?', 'Seuls les artisans vérifiés qui exercent le métier concerné et interviennent dans votre département. Ils voient la description, les photos, la ville et le code postal. Votre nom, votre adresse exacte et votre téléphone ne sont transmis qu’à l’artisan dont vous acceptez le devis.'],
    ['Combien de devis vais-je recevoir ?', 'Cela dépend des artisans disponibles dans votre secteur. Vous êtes prévenu par e-mail à chaque nouveau devis. Si personne ne répond, notre équipe vous aide à trouver un professionnel.'],
    ['Suis-je obligé d’accepter un devis ?', 'Non. Vous êtes libre de n’en accepter aucun et pouvez annuler votre demande à tout moment tant qu’aucun devis n’est accepté.'],
    ['Que contient un devis ?', 'Toutes les mentions exigées pour les travaux : décompte détaillé de chaque prestation, taux horaire TTC, frais de déplacement, totaux HT et TTC, taux de TVA, date de début, durée, validité de l’offre, et l’assurance décennale de l’artisan.'],
    ['Comment laisser un avis ?', 'Une fois les travaux terminés, cliquez sur « Les travaux sont terminés » dans votre demande, puis notez l’artisan. Seuls les clients ayant réellement fait appel à un artisan peuvent le noter.'],
  ],
  'Artisans': [
    ['Comment mon profil est-il vérifié ?', 'Nous contrôlons votre SIRET sur l’annuaire des entreprises et votre attestation d’assurance décennale (assureur, contrat, validité, activités couvertes). Pour les métiers qui l’exigent, nous pouvons demander votre qualification.'],
    ['Quelles demandes vais-je recevoir ?', 'Uniquement celles qui correspondent à vos métiers et à vos départements d’intervention. Vous êtes prévenu par e-mail.'],
    ['Combien ça coûte ?', 'Servizone est gratuit pour les artisans pendant la phase pilote. Voir la page tarifs.'],
    ['Quand ai-je les coordonnées du client ?', 'Dès qu’il accepte votre devis. Avant, vous pouvez échanger avec lui par la messagerie du devis.'],
  ],
  'Compte et données': [
    ['J’ai oublié mon mot de passe', 'Cliquez sur « Mot de passe oublié ? » sur la page de connexion : vous recevrez un lien valable 1 heure.'],
    ['Comment supprimer mon compte ?', 'Depuis « Mon compte », en bas de page. Votre compte, vos demandes, devis, photos et avis sont effacés définitivement.'],
    ['Comment sont protégées mes données ?', 'Elles servent uniquement à la mise en relation, ne sont jamais vendues et sont supprimées après 3 ans d’inactivité. Tout est détaillé dans la politique de confidentialité.'],
  ],
}; %>
<div class="narrow">
  <div class="page-head"><p class="eyebrow">Aide</p><h1 class="display">Questions fréquentes</h1></div>
  <% Object.entries(faq).forEach(([section, items]) => { %>
    <section class="panel" style="margin-top:20px">
      <h2 style="font-size:1.3rem"><%= section %></h2>
      <% items.forEach(([q, a]) => { %><details class="faq"><summary><%= q %></summary><p><%= a %></p></details><% }) %>
    </section>
  <% }) %>
  <div class="panel panel-dark" style="margin-top:24px;display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap">
    <div><h3 style="margin:0">Vous n'avez pas trouvé la réponse ?</h3><span class="muted">Notre équipe vous répond sous 48 h ouvrées.</span></div>
    <a class="btn btn-sand" href="/contact">Nous contacter</a>
  </div>
</div>
<%- include('partials/foot') %>
