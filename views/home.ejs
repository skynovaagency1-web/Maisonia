<%- include('partials/head') %>
<% const cats = Object.entries(CATEGORIES); %>
<div class="wrap">
  <section class="hero" style="--hero-img:url('<%= HERO %>')">
    <div class="watermark" aria-hidden="true">SERVIZONE</div>
    <div class="hero-grid">
      <div>
        <p class="eyebrow">Plomberie · Électricité · Peinture · Petits travaux</p>
        <h1 class="display">Le bon artisan,<br><em>près de chez vous</em></h1>
        <p class="lead">Décrivez vos travaux en deux minutes, ajoutez quelques photos et recevez des devis détaillés d'artisans vérifiés de votre secteur. Gratuit et sans engagement.</p>
        <form class="search" action="/demandes/nouvelle" method="get" role="search">
          <label class="sr-only" for="hero-cat" style="position:absolute;left:-9999px">Type de travaux</label>
          <select id="hero-cat" name="categorie">
            <% cats.forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %>
          </select>
          <button class="btn btn-sand" type="submit">Décrire mes travaux <span class="arrow">→</span></button>
        </form>
        <div class="hero-proof">
          <span class="chip">✓ SIRET contrôlé</span>
          <span class="chip">✓ Assurance décennale vérifiée</span>
          <span class="chip">★ Avis de clients réels</span>
        </div>
      </div>
      <div>
        <p class="deck-label">Ils font appel à Servizone</p>
        <div class="deck" id="deck" aria-label="Exemples de travaux">
          <% const featured = [['plomberie','Fuite sous évier réparée','Paris 11e'],['peinture','Salon repeint en 2 jours','Montreuil'],['electricite','Tableau électrique remis aux normes','Boulogne'],['petits-travaux','Étagères et luminaires posés','Vincennes'],['peinture','Chambre d’enfant rafraîchie','Saint-Denis']]; %>
          <% featured.forEach(([c, t, city], i) => { %>
            <article class="card-photo" data-pos="<%= i < 3 ? i : 'out' %>">
              <img src="<%= photoFor(c, i) %>" alt="<%= CATEGORIES[c] %> : <%= t %>" loading="<%= i ? 'lazy' : 'eager' %>">
              <div class="cap"><strong><%= t %></strong><span class="small"><%= city %></span><br><span class="pill"><%= CATEGORIES[c] %></span></div>
            </article>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <div><p class="eyebrow">Nos métiers</p><h2 class="display">Que faut-il faire chez vous ?</h2></div>
      <a class="btn btn-light" href="/artisans">Voir les artisans <span class="arrow">→</span></a>
    </div>
    <div class="grid grid-4">
      <% const blurbs = { plomberie: 'Fuites, chauffe-eau, sanitaires', electricite: 'Prises, tableaux, éclairage', peinture: 'Murs, plafonds, boiseries', 'petits-travaux': 'Montage, pose, réparations' }; %>
      <% cats.forEach(([k, v], i) => { %>
        <a class="cat-card" href="/demandes/nouvelle?categorie=<%= k %>">
          <img src="<%= photoFor(k, 0) %>" alt="" loading="lazy">
          <div class="inner"><div><h3><%= v %></h3><span class="small"><%= blurbs[k] %></span></div><span class="go">→</span></div>
        </a>
      <% }) %>
    </div>
  </section>
</div>

<section aria-label="Réalisations">
  <div class="wrap section-head"><div><p class="eyebrow">Réalisations</p><h2 class="display">Des chantiers, des sourires</h2></div></div>
  <% const tiles = []; Object.keys(PHOTOS).forEach(k => PHOTOS[k].forEach((src, i) => tiles.push([k, src]))); %>
  <div class="rail"><div class="rail-track">
    <% [...tiles, ...tiles].forEach(([k, src], i) => { %>
      <a class="tile" href="/demandes/nouvelle?categorie=<%= k %>" <%= i >= tiles.length ? 'aria-hidden=true tabindex=-1' : '' %>>
        <img src="<%= src.replace('w=900', 'w=500') %>" alt="<%= i < tiles.length ? CATEGORIES[k] : '' %>" loading="lazy">
        <span class="tile-cap"><strong><%= CATEGORIES[k] %></strong><span>→</span></span>
      </a>
    <% }) %>
  </div></div>
</section>

<div class="wrap">
  <section id="comment">
    <div class="section-head"><div><p class="eyebrow">Comment ça marche</p><h2 class="display">Trois étapes, zéro prise de tête</h2></div></div>
    <div class="grid grid-3">
      <div class="panel step"><div class="num">01</div><h3>Décrivez vos travaux</h3><p class="muted">Le type de travaux, votre code postal, quelques photos. Votre adresse exacte reste privée.</p></div>
      <div class="panel step"><div class="num">02</div><h3>Comparez les devis</h3><p class="muted">Les artisans vérifiés de votre secteur vous envoient un devis détaillé, ligne par ligne. Comparez prix, avis et réalisations.</p></div>
      <div class="panel step"><div class="num">03</div><h3>Choisissez et notez</h3><p class="muted">Acceptez le devis qui vous convient : vous échangez vos coordonnées. Après le chantier, laissez un avis.</p></div>
    </div>
  </section>

  <section id="confiance">
    <div class="grid grid-2" style="align-items:stretch">
      <div class="panel panel-dark">
        <p class="eyebrow" style="color:var(--gold)">La confiance avant tout</p>
        <h2 class="display" style="font-family:var(--display);font-weight:300;font-size:2.2rem">Chaque artisan est contrôlé</h2>
        <p class="muted">Avant de pouvoir envoyer un devis, chaque professionnel passe par notre vérification manuelle.</p>
        <div class="grid" style="margin-top:22px">
          <div class="icon-row"><span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M7 9h10M7 13h6"/></svg></span><div><strong>Entreprise immatriculée</strong><br><span class="muted small">Numéro SIRET contrôlé au registre national des entreprises.</span></div></div>
          <div class="icon-row"><span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg></span><div><strong>Assurance décennale à jour</strong><br><span class="muted small">Attestation, assureur et date de validité vérifiés, rappelés sur chaque devis.</span></div></div>
          <div class="icon-row"><span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h9l4 4v14H6z"/><path d="M9 12h6M9 16h6M9 8h3"/></svg></span><div><strong>Devis conformes</strong><br><span class="muted small">Décompte détaillé, taux horaire TTC, totaux HT et TTC, durée de validité.</span></div></div>
        </div>
      </div>
      <div class="panel" style="display:grid;align-content:space-between;gap:24px">
        <div>
          <p class="eyebrow">Vous êtes artisan ?</p>
          <h2>Des chantiers près de chez vous, sans démarchage</h2>
          <p class="muted">Indiquez vos métiers et vos départements : vous ne recevez que les demandes qui vous correspondent. Présentez vos réalisations et laissez vos avis parler pour vous.</p>
        </div>
        <div class="grid grid-3">
          <div><div class="kpi"><%= stats.artisans %></div><span class="small muted">artisans vérifiés</span></div>
          <div><div class="kpi"><%= stats.requests %></div><span class="small muted">demandes publiées</span></div>
          <div><div class="kpi"><%= stats.rating ? String(stats.rating).replace('.', ',') : '—' %></div><span class="small muted">note moyenne / 5</span></div>
        </div>
        <div><a class="btn btn-dark" href="/inscription?role=artisan">Rejoindre Servizone <span class="arrow">→</span></a></div>
      </div>
    </div>
  </section>
</div>
<script>
  // Fait défiler les cartes de la pile une à une.
  (() => {
    const deck = document.getElementById('deck');
    if (!deck || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const cards = [...deck.children];
    let start = 0;
    setInterval(() => {
      start = (start + 1) % cards.length;
      cards.forEach((c, i) => {
        const pos = (i - start + cards.length) % cards.length;
        c.dataset.pos = pos < 3 ? pos : 'out';
      });
    }, 3200);
  })();
</script>
<%- include('partials/foot') %>
